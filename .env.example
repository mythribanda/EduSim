# =============================================================================
# EduSim Root Environment Configuration (.env.example)
# Use this file to configure environment variables for local Windows development
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Local PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=edusim
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/edusim

# -----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# -----------------------------------------------------------------------------
# Cryptographic secret key for signing JWT tokens (MUST be at least 32 characters)
JWT_SECRET=your-32-byte-secure-jwt-secret-key-here
JWT_SECRET_KEY=your-32-byte-secure-jwt-secret-key-here

# -----------------------------------------------------------------------------
# Google OAuth2 (REQUIRED)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# URLs & Allowed Origins
# -----------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8001
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# AI Router & Inference Configuration
# -----------------------------------------------------------------------------
# Mode 1: Local Ollama on Windows
USE_CLOUD_AI=false
ALLOW_CLOUD_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096

# Mode 2: Cloud LLM (OpenRouter) Fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Vector Store & Textbooks
# -----------------------------------------------------------------------------
FAISS_INDEX_V2_DIR=faiss_index_v2
TEXTBOOKS_DIR=textbooks
