# =============================================================================
# EduSim Root Environment Configuration (.env.example)
# Use this file to configure environment variables for Docker Compose
# Copy to .env: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=edusim_secret_password
POSTGRES_DB=edusim

# -----------------------------------------------------------------------------
# Authentication & Security (REQUIRED)
# -----------------------------------------------------------------------------
# Cryptographic secret key for signing JWT tokens (MUST be at least 32 characters)
JWT_SECRET=your-32-byte-secure-jwt-secret-key-here
JWT_SECRET_KEY=your-32-byte-secure-jwt-secret-key-here

# -----------------------------------------------------------------------------
# Google OAuth2 (REQUIRED)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# URLs & Allowed Origins
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8001
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://frontend:8080

# -----------------------------------------------------------------------------
# AI Router & Inference Configuration
# -----------------------------------------------------------------------------
# Mode 1: Local Ollama on Host (via host.docker.internal)
USE_CLOUD_AI=false
ALLOW_CLOUD_FALLBACK=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096

# Mode 2: Containerized Ollama (docker compose --profile ollama up)
# OLLAMA_BASE_URL=http://ollama:11434

# Mode 3: Cloud LLM (OpenRouter)
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Vector Store & Textbooks (Single source of truth)
# -----------------------------------------------------------------------------
FAISS_INDEX_V2_DIR=/app/faiss_index_v2
TEXTBOOKS_DIR=/data/textbooks
