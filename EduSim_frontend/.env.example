# Frontend Environment Variables (.env.example)

# URL of the backend FastAPI service accessible from the user's browser
# In local Docker setup, this defaults to http://localhost:8001
VITE_API_URL=http://localhost:8001

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

