# =============================================================================
# EduSim_API Environment Configuration (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (e.g. Supabase, local PostgreSQL, or SQLite)
# Example: postgresql://postgres:password@localhost:5432/edusim
DATABASE_URL=sqlite:///./edusim.db

# Optional SSL mode for PostgreSQL connections (e.g. "require", "disable")
# Only passed to database engine when explicitly set. Default: unset
# DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Cryptographic secret key for signing JWT tokens (MUST be at least 32 characters)
# Generate securely with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-32-byte-secure-jwt-secret-key-here
# Legacy alias for JWT_SECRET (JWT_SECRET takes precedence, or JWT_SECRET_KEY is checked)
JWT_SECRET_KEY=your-32-byte-secure-jwt-secret-key-here

# -----------------------------------------------------------------------------
# CORS & Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080

# Additional individual allowed URLs for the frontend
FRONTEND_URL=http://localhost:8080
ADDITIONAL_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# AI Router & Inference Configuration
# -----------------------------------------------------------------------------
# When set to true, forces AI Router to bypass local Ollama and directly use OpenRouter
USE_CLOUD_AI=false

# Local Ollama Inference (Default Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Ollama request timeout in seconds. Default: 60 (prevents spurious fallback during cold starts)
OLLAMA_TIMEOUT=60
# Script generation timeout in seconds (used by scripts/generate_topic_content.py)
OLLAMA_TIMEOUT_SECONDS=300

# Cloud Fallback Inference (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional comma-separated list of fallback models
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct

# -----------------------------------------------------------------------------
# Vector Store & RAG Configuration
# -----------------------------------------------------------------------------
# Absolute directory path for the FAISS index (defaults to <EduSim_API>/faiss_index if unset)
FAISS_INDEX_DIR=

# Absolute directory path for physics textbooks / PDFs (defaults to <EduSim_API>/data/physics if unset)
TEXTBOOKS_DIR=

# -----------------------------------------------------------------------------
# Google OAuth & Supabase Integration
# -----------------------------------------------------------------------------
# Google OAuth Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Supabase Configuration (Required if using Supabase Auth or Storage)
SUPABASE_URL=https://your-project.supabase.co
