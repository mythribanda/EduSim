# =============================================================================
# EduSim_API Environment Configuration (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (e.g. Supabase, local PostgreSQL, or SQLite)
# Example: postgresql://postgres:password@localhost:5432/edusim
DATABASE_URL=sqlite:///./edusim.db

# Optional SSL mode for PostgreSQL connections (e.g. "require", "disable")
# Only passed to database engine when explicitly set. Default: unset
# DB_SSLMODE=require

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Cryptographic secret key for signing JWT tokens (MUST be at least 32 characters)
# Generate securely with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-32-byte-secure-jwt-secret-key-here
# Legacy alias for JWT_SECRET (JWT_SECRET takes precedence, or JWT_SECRET_KEY is checked)
JWT_SECRET_KEY=your-32-byte-secure-jwt-secret-key-here

# -----------------------------------------------------------------------------
# CORS & Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080

# Additional individual allowed URLs for the frontend
FRONTEND_URL=http://localhost:8080
ADDITIONAL_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# AI Router & Inference Configuration
# -----------------------------------------------------------------------------
# Mode 1 (Default): Local Ollama on Host
#   - Set OLLAMA_BASE_URL=http://localhost:11434 (or http://host.docker.internal:11434 in Docker)
#   - Run: ollama run gemma3:4b
#   - When ALLOW_CLOUD_FALLBACK=false, returns HTTP 503 error if Ollama is unreachable.
# Mode 2: Containerized Ollama
#   - Run: docker compose --profile ollama up
#   - Set OLLAMA_BASE_URL=http://ollama:11434
# Mode 3: Cloud-Only Mode (OpenRouter)
#   - Set USE_CLOUD_AI=true
#   - Set OPENROUTER_API_KEY=your-openrouter-api-key-here
#   - Set ALLOW_CLOUD_FALLBACK=true

# Force cloud bypass of local Ollama (true = Mode 3)
USE_CLOUD_AI=false

# Local Ollama Inference (Default Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Ollama request timeout in seconds (separate: connect 3s, read timeout default: 180s for local CPU)
OLLAMA_TIMEOUT=180
# Ollama keep-alive duration to keep model resident in memory between questions (default: 30m)
OLLAMA_KEEP_ALIVE=30m
# Context window size in tokens for Ollama (prevents silent truncation, default: 4096)
OLLAMA_NUM_CTX=4096
# Prompt context size limits for the 4B model (configurable via env)
OLLAMA_MAX_CHUNKS=4
OLLAMA_MAX_CONTEXT_TOKENS=1500
# Script generation timeout in seconds (used by scripts/generate_topic_content.py)
OLLAMA_TIMEOUT_SECONDS=300

# Cloud Fallback Inference (OpenRouter)
# Allow fallback to OpenRouter when Ollama fails/unreachable (default false when OPENROUTER_API_KEY is empty)
ALLOW_CLOUD_FALLBACK=false
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional comma-separated list of fallback models
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct
OPENROUTER_MAX_CHUNKS=8
OPENROUTER_MAX_CONTEXT_TOKENS=4000

# -----------------------------------------------------------------------------
# Vector Store & RAG Configuration
# -----------------------------------------------------------------------------
# Absolute directory path for the FAISS index (single source of truth, defaults to <EduSim_API>/faiss_index_v2 if unset)
FAISS_INDEX_V2_DIR=

# Absolute directory path for textbooks / PDFs (defaults to <EduSim_API>/textbooks if unset)
TEXTBOOKS_DIR=

# -----------------------------------------------------------------------------
# Google OAuth & Supabase Integration
# -----------------------------------------------------------------------------
# Google OAuth Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Supabase Configuration (Required if using Supabase Auth or Storage)
SUPABASE_URL=https://your-project.supabase.co
